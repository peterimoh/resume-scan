# Production template for internet-facing deployment. Copy to backend/.env,
# fill in real values, and generate secrets with e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- LLM configuration (app/llm.py) -----------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7
LLM_MAX_TOKENS=16000

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public URLs (must be the real internet-facing HTTPS domains, not
# localhost) — these drive CORS, cookie scoping, and the OAuth redirect URI.
CORS_ORIGINS=https://resume.yourdomain.com
FRONTEND_URL=https://resume.yourdomain.com
BACKEND_BASE_URL=https://api.resume.yourdomain.com

# Required once served over HTTPS (which it must be, if exposed publicly) so
# the session cookie is never sent in the clear.
COOKIE_SECURE=true

# Required to create a new account (email/password register, or first-time
# Google sign-in) — share this only with people you invite. Leave unset for
# open registration.
SIGNUP_CODE=

# --- Database ----------------------------------------------------------------
# Set by docker-compose.yml to the mounted volume path; leave unset here
# unless you're running outside that compose file.
# DB_PATH=/app/data/resume.db

# --- Job board (n8n) — REQUIRED once this leaves your LAN. Unset silently
# disables the auth check on /internal/*, so an unset key here means anyone
# who finds the backend can inject fake job postings.
INTERNAL_API_KEY=

# --- Telegram connect flow — REQUIRED once this leaves your LAN, for the
# same reason: an unset secret means the webhook accepts unsigned requests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
