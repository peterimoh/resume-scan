% Compact list environments (no enumitem — keep the same "no external list
% packages" convention as the resume templates' resitemize).
\newenvironment{reportitemize}{%
  \begin{itemize}
    \setlength{\itemsep}{3pt}
    \setlength{\parsep}{0pt}
    \setlength{\topsep}{3pt}
    \setlength{\leftmargin}{1.4em}
}{%
  \end{itemize}
}

\newenvironment{reportenumerate}{%
  \begin{enumerate}
    \setlength{\itemsep}{3pt}
    \setlength{\parsep}{0pt}
    \setlength{\topsep}{3pt}
    \setlength{\leftmargin}{1.6em}
}{%
  \end{enumerate}
}

