# Copy to backend/.env and fill in real values.

# LLM configuration (used by app/llm.py for HR/ATS analysis) — any
# OpenAI-compatible chat-completions API works here.
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7
# Max output tokens per completion. Raise this if HR/ATS reports get cut off
# ("the response was truncated") on long resumes or job descriptions.
LLM_MAX_TOKENS=16000

GOOGLE_CLIENT_ID=...      # from Google Cloud Console → OAuth client
GOOGLE_CLIENT_SECRET=...

# When set, new-account creation (email/password register, or first-time
# Google sign-in) requires this code. Leave unset for open registration
# (fine for local dev / LAN-only).
SIGNUP_CODE=

# Comma-separated list of allowed frontend origins (for CORS + cookies).
CORS_ORIGINS=http://localhost:5173

# Set to true when serving the backend over HTTPS in production, so the
# session cookie is only sent over secure connections.
COOKIE_SECURE=false

# Optional: override the SQLite database path. Defaults to the repo-root
# resume.db (the original Streamlit app's database), so existing data is
# picked up and migrated in place.
# DB_PATH=/path/to/resume.db

# Shared secret required on the /internal/* job-board endpoints (called by
# the n8n workflow, not the frontend). Leave unset only for local dev.
INTERNAL_API_KEY=

# Telegram connect flow (job alerts). Create a bot via @BotFather to get the
# token + username. TELEGRAM_WEBHOOK_SECRET is whatever you pass as
# setWebhook's secret_token — Telegram echoes it back on every webhook call
# so we can reject spoofed requests; leave unset only for local dev.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
